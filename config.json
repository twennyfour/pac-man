# Game configuration: JSON, plus comment lines starting with '#' or '//'.
# Every key is optional. A missing or invalid value falls back to its
# default, a number out of range is clamped, and a warning is printed.
# Unknown keys are ignored. The README "Configuration" section lists them all.
{
    # File where the top 10 highscores are saved.
    "highscore_filename": "highscores.json",

    # Lives at the start of a game (1 to 10).
    "lives": 3,

    # Pacgums placed in each level (1 to 2500).
    "pacgum": 42,

    # Points per pacgum, super-pacgum and eaten ghost (0 to 100000).
    "points_per_pacgum": 10,
    "points_per_super_pacgum": 50,
    "points_per_ghost": 200,

    # Seed of the first level's maze (1 to 2147483647).
    # Later levels get a random maze.
    "seed": 42,

    # Time limit of each level, in seconds (10 to 3600).
    "level_max_time": 90,

    # One entry per level, played in this order. At least 10 levels:
    # missing ones are added with default sizes. Width and height are in
    # cells (7 to 50).
    "level": [
        {"width": 15, "height": 15},
        {"width": 16, "height": 16},
        {"width": 17, "height": 17},
        {"width": 18, "height": 18},
        {"width": 19, "height": 19},
        {"width": 20, "height": 20},
        {"width": 21, "height": 21},
        {"width": 22, "height": 22},
        {"width": 23, "height": 23},
        {"width": 24, "height": 24}
    ]
}
